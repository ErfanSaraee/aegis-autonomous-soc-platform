# --- Application & API Configuration ---
APP_NAME="AEGIS Autonomous Agentic SOC & SOAR Platform"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# --- Relational & Vector Database (Async SQLite locally; PostgreSQL + pgvector in Docker/Prod) ---
DATABASE_URL="sqlite+aiosqlite:///./aegis_soc_telemetry.db"
POSTGRES_PGVECTOR_URL="postgresql+asyncpg://aegis:aegis_secret@localhost:5432/aegis_soc"

# --- Distributed Task Queue & Caching (Celery + Redis) ---
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"
CELERY_TASK_ALWAYS_EAGER=True

# --- Multi-Provider LLM & VLM Gateway (OpenAI, Anthropic, Google Gemini, Ollama, vLLM, HuggingFace) ---
DEFAULT_LLM_PROVIDER="anthropic"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-7-sonnet-latest"
GOOGLE_GEMINI_API_KEY=""
GOOGLE_GEMINI_MODEL="gemini-2.5-flash"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.3:8b"
VLLM_BASE_URL="http://localhost:8001/v1"
VLLM_MODEL="meta-llama/Llama-3.3-70B-Instruct"
HUGGINGFACE_API_TOKEN=""

# --- LangSmith Agent Observability & Tracing ---
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="aegis-autonomous-soc"

# --- Hybrid Vector Threat Intelligence (Pinecone, ChromaDB & RRF) ---
PINECONE_API_KEY=""
PINECONE_INDEX_NAME="mitre-attack-cti-index"
CHROMA_PERSIST_DIR="./chroma_db"
RRF_K_CONSTANT=60

# --- PyTorch, XGBoost & Zero-Trust SOC Guardrail Thresholds ---
PYTORCH_ANOMALY_THRESHOLD=0.65
SHANNON_ENTROPY_THRESHOLD=4.40
AST_MAX_COMPLEXITY=12
AUTO_ISOLATE_CONFIDENCE_THRESHOLD=0.88
DSPY_OPTIMIZATION_ROUNDS=3